# Cursor Rules for Profile Manager Project

# File and Directory Naming

_.tsx # Component files
_.ts # Utility files
_-_ # Kebab-case for files and directories
[a-z]+/ # Lowercase directory names

# Component Organization

components/ui/\_ # shadcn UI components location
app/page.tsx # Home page
app/layout.tsx # Root layout
app/globals.css # Global styles

# Next.js App Router Structure

app/_/page.tsx # Page components in route directories
app/_/layout.tsx # Layout components
app/_/error.tsx # Error handling pages
app/_/loading.tsx # Loading states

# Component Naming Conventions

[A-Z][a-zA-Z]_\.tsx # PascalCase for React components
[a-z][a-zA-Z]_ # camelCase for functions and variables

# Route Groups

app/\([a-z-]+\)/\* # Route groups in parentheses

# Type Organization

types/\_ # TypeScript type definitions and interfaces
types/[a-z-]+\.ts # Type files in kebab-case
types/index.ts # Type exports barrel file

# Schema Organization

schemas/\_ # Zod schema definitions
schemas/[a-z-]+\.ts # Schema files in kebab-case
schemas/index.ts # Schema exports barrel file

# Static Assets

public/\* # Public assets directory

# shadcn Component Installation

npx shadcn@latest add <component-name> # Command to add new shadcn components
